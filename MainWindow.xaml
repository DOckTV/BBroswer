<Window x:Class="Search.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Search" Width="1380" Height="880" MinWidth="760" MinHeight="520" Background="#171717" Foreground="#EEEEEE" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EAEAEA"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F5F5F5"/><Setter Property="Background" Value="#303030"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="14"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="25"/></Grid.RowDefinitions>
  <Border Grid.Column="0" Background="#1D1D1D" Padding="10"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><DockPanel Margin="2,2,2,14"><TextBlock Text="SEARCH" FontSize="13" FontWeight="Bold" Foreground="#B9D7C5" VerticalAlignment="Center"/><Button Content="+" Click="NewTab_Click" HorizontalAlignment="Right" Padding="8,2" ToolTip="New tab (Ctrl+T)"/></DockPanel><TextBlock Text="TABS" Foreground="#777777" FontSize="10" Margin="5,4"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Separator Background="#383838" Margin="0,0,0,8"/>
    <Button Content="☆  Bookmarks" Click="ShowBookmarks_Click" HorizontalContentAlignment="Left"/><Button Content="◷  History" Click="ShowHistory_Click" HorizontalContentAlignment="Left"/><Button Content="↓  Downloads" Click="ShowDownloads_Click" HorizontalContentAlignment="Left"/><Button Content="⚙  Settings" Click="Settings_Click" HorizontalContentAlignment="Left"/><Button Content="＋  Private tab" Click="NewPrivateTab_Click" HorizontalContentAlignment="Left"/>
   </StackPanel>
   <ListBox x:Name="TabsList" Background="Transparent" BorderThickness="0" Foreground="#EAEAEA" SelectionChanged="TabsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><Button Content="×" Tag="{Binding}" Click="CloseTab_Click" Padding="5,3" DockPanel.Dock="Right" ToolTip="Close tab"/><TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,7"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Background="#202020"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Content="←" Click="Back_Click"/><Button Grid.Column="1" Content="→" Click="Forward_Click"/><Button Grid.Column="2" Content="↻" Click="Reload_Click"/>
    <TextBox x:Name="AddressBox" Grid.Column="3" Margin="6,8" VerticalContentAlignment="Center" KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotKeyboardFocus"/>
    <Button Grid.Column="4" Content="☆" Click="Bookmark_Click" ToolTip="Bookmark this page"/><Button Grid.Column="5" Content="⋯" Click="PageMenu_Click" ToolTip="Page actions"/>
   </Grid><Grid Grid.Row="1" x:Name="BrowserHost" Background="#FFFFFF"/>
  </Grid>
  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#171717"><TextBlock x:Name="StatusText" Text="A quieter place to browse." Foreground="#888888" FontSize="11" VerticalAlignment="Center" Margin="10,0"/></Border>
 </Grid>
</Window>