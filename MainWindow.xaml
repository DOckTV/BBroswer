<Window x:Class="Search.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BBroswer" Width="1440" Height="900" MinWidth="900" MinHeight="600"
        Background="#111315" Foreground="#E9ECEF" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBrush" Color="#171A1D"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1D2125"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B949E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#B7D8C5"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#DDE2E6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#292F34"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#343D43"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F0F3F5"/>
            <Setter Property="Background" Value="#252B30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#B7D8C5"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#DDE2E6"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#2A3531"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#252C30"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#292E32" BorderThickness="0,0,1,0" Padding="14,18,12,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="4,0,4,22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="10" Background="#B7D8C5" VerticalAlignment="Center">
                            <TextBlock Text="B" Foreground="#17221C" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                            <TextBlock Text="BBroswer" FontSize="16" FontWeight="SemiBold" Foreground="#F0F3F5"/>
                            <TextBlock Text="A quieter place to browse" FontSize="10" Foreground="#89939B" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="+    New tab" Click="NewTab_Click" Background="#B7D8C5" Foreground="#18231D" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="13,11" Margin="0,0,0,22"/>
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="#7E8991" Margin="5,0,0,8"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Border Height="1" Background="#2A3034" Margin="3,0,3,10"/>
                    <Button Style="{StaticResource SidebarAction}" Content="☆    Bookmarks" Click="ShowBookmarks_Click"/>
                    <Button Style="{StaticResource SidebarAction}" Content="◷    History" Click="ShowHistory_Click"/>
                    <Button Style="{StaticResource SidebarAction}" Content="↓    Downloads" Click="ShowDownloads_Click"/>
                    <Button Style="{StaticResource SidebarAction}" Content="◉    Private tab" Click="NewPrivateTab_Click"/>
                    <Button Style="{StaticResource SidebarAction}" Content="⚙    Settings" Click="Settings_Click"/>
                    <TextBlock Text="EARLY ACCESS  ·  WINDOWS" FontSize="9" Foreground="#66717A" Margin="7,15,0,2"/>
                </StackPanel>

                <ListBox x:Name="TabsList" SelectionChanged="TabsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="◦" FontSize="17" Foreground="#A9CDB8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="5,7,3,7" FontSize="12"/>
                                <Button Grid.Column="2" Content="×" Tag="{Binding}" Click="CloseTab_Click" Padding="5,3" FontSize="15" ToolTip="Close tab"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#171A1D" BorderBrush="#292E32" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/><ColumnDefinition Width="38"/><ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Grid.Column="0" Content="←" FontSize="19" Click="Back_Click" ToolTip="Back"/>
                    <Button x:Name="ForwardButton" Grid.Column="1" Content="→" FontSize="19" Click="Forward_Click" ToolTip="Forward"/>
                    <Button Grid.Column="2" Content="↻" FontSize="18" Click="Reload_Click" ToolTip="Reload"/>
                    <Border Grid.Column="3" Background="#252B30" CornerRadius="10" Margin="9,10" BorderBrush="#343C42" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" FontSize="20" Foreground="#9BA7AE" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBox x:Name="AddressBox" Grid.Column="1" Background="Transparent" Padding="3,8" VerticalContentAlignment="Center" BorderThickness="0" KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotKeyboardFocus" ToolTip="Search or enter an address  ·  Ctrl+L"/>
                        </Grid>
                    </Border>
                    <Button Grid.Column="4" Content="☆" FontSize="18" Click="Bookmark_Click" ToolTip="Bookmark this page"/>
                    <Button Grid.Column="5" Content="···" FontSize="17" Click="PageMenu_Click" ToolTip="Page tools"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" x:Name="BrowserHost" Background="#FFFFFF"/>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#141719" BorderBrush="#292E32" BorderThickness="0,1,0,0">
            <Grid Margin="13,0">
                <TextBlock x:Name="StatusText" Text="Ready when you are." Foreground="#849098" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Text="BBROWSER" Foreground="#566169" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>