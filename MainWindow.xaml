<Window x:Class="Search.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Search" Width="1200" Height="800" MinWidth="620" MinHeight="420"
        Background="{StaticResource ChromeBackground}" Foreground="{StaticResource ChromeText}"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
      <RowDefinition Height="24" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource ChromeBackground}">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Left" Content="+" Width="44" Click="NewTab_Click" ToolTip="New tab (Ctrl+T)" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="TabItems">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{Binding IsSelected, Converter={x:Static BooleanToVisibilityConverter.Instance}}"
                        Margin="2,5" CornerRadius="7">
                  <DockPanel>
                    <Button Content="{Binding Title}" Tag="{Binding}" Click="SelectTab_Click"
                            MaxWidth="190" Padding="12,7" />
                    <Button Content="×" Tag="{Binding}" Click="CloseTab_Click" Padding="5,5" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Background="{StaticResource ChromePanel}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="42" /><ColumnDefinition Width="42" />
        <ColumnDefinition Width="42" /><ColumnDefinition Width="*" />
        <ColumnDefinition Width="42" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="←" Click="Back_Click" ToolTip="Back" />
      <Button Grid.Column="1" Content="→" Click="Forward_Click" ToolTip="Forward" />
      <Button Grid.Column="2" Content="↻" Click="Reload_Click" ToolTip="Reload" />
      <TextBox x:Name="AddressBox" Grid.Column="3" Margin="4,6" Padding="12,4"
               VerticalContentAlignment="Center" Background="#FF303030" Foreground="White"
               BorderThickness="0" FontSize="14" KeyDown="AddressBox_KeyDown"
               GotKeyboardFocus="AddressBox_GotKeyboardFocus" />
      <Button Grid.Column="4" Content="⋯" Click="NewTab_Click" ToolTip="New tab" />
    </Grid>

    <Grid Grid.Row="2" x:Name="BrowserHost" Background="White" />

    <Border Grid.Row="3" Background="{StaticResource ChromeBackground}">
      <TextBlock x:Name="StatusText" Text="Search for Windows · Early development build"
                 Foreground="{StaticResource ChromeMuted}" FontSize="11"
                 VerticalAlignment="Center" Margin="10,0" />
    </Border>
  </Grid>
</Window>
