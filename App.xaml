<Application x:Class="Search.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="ChromeBackground" Color="#FF171717" />
    <SolidColorBrush x:Key="ChromePanel" Color="#FF222222" />
    <SolidColorBrush x:Key="ChromeText" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="ChromeMuted" Color="#FF999999" />
    <SolidColorBrush x:Key="Accent" Color="#FFB7D7C2" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource ChromeText}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Application.Resources>
</Application>
